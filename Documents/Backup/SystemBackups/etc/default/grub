# /etc/default/grub - Configuración para PC Host (CachyOS / Arch Linux)

# Selección de menú y tiempos
GRUB_DEFAULT=saved
GRUB_SAVEDEFAULT=true
GRUB_TIMEOUT=10
GRUB_TIMEOUT_STYLE=menu
GRUB_DISTRIBUTOR="Arch"

# Parámetros del Kernel
GRUB_CMDLINE_LINUX_DEFAULT="root=UUID=702e821f-a5bc-49d1-b6f2-dc8d6ea2b4c6 rootflags=subvol=@ rootfstype=btrfs quiet nowatchdog mitigations=off loglevel=3 nvme_core.default_ps_max_latency_us=5500 tsc=reliable clocksource=tsc 8250.nr_uarts=0 zswap.enabled=0"
GRUB_CMDLINE_LINUX=""

# Módulos y pantalla
GRUB_PRELOAD_MODULES="part_gpt part_msdos"
GRUB_TERMINAL_INPUT=console
GRUB_GFXMODE=1920x1080,auto
GRUB_GFXPAYLOAD_LINUX=keep

# Tema visual
GRUB_BACKGROUND="/usr/share/grub/themes/Solara-left/background.jpg"
GRUB_THEME="/usr/share/grub/themes/Solara-left/theme.txt"

# Opciones de seguridad y detección
GRUB_DISABLE_RECOVERY=true
GRUB_DISABLE_OS_PROBER=true
